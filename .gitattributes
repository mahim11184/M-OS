# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell and Automation Scripts
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf

# Configuration & Data Files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.ini text eol=lf
*.rc text eol=lf
*.list text eol=lf
*.chroot text eol=lf

# Styling & Web Languages
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Binary & Image Assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg text eol=lf

# ISO Disk Images & Archives
*.iso filter=lfs diff=lfs merge=lfs -text
*.tar.gz binary
*.zip binary
