{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS          ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "Kernel      ",
      "keyColor": "cyan"
    },
    {
      "type": "uploader",
      "key": "Uptime      ",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "Packages    ",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "WM          ",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "Terminal    ",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "CPU         ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "Memory      ",
      "keyColor": "cyan"
    },
    "break",
    "colors"
  ]
}
