[Unit]
Description=Enable the Flathub repository for Mighty Linux
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/bin/flatpak
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target
