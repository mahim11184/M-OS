# Mighty Linux animated Plymouth splash
Window.SetBackgroundTopColor(0.025, 0.035, 0.085);
Window.SetBackgroundBottomColor(0.010, 0.015, 0.045);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Mahim's boot artwork is the theme's own splash background.
boot_image = Image("boot.jpg");
boot_sprite = Sprite();
boot_sprite.SetImage(boot_image);
boot_sprite.SetX(Window.GetX() + (screen_width / 2 - boot_image.GetWidth() / 2));
boot_sprite.SetY(Window.GetY() + (screen_height / 2 - boot_image.GetHeight() / 2));
boot_sprite.SetZ(-100);

# Four text frames loop continuously while Plymouth is active.
spinner_image[0] = Image.Text("|", 0.05, 0.78, 1.0);
spinner_image[1] = Image.Text("/", 0.05, 0.78, 1.0);
spinner_image[2] = Image.Text("-", 0.05, 0.78, 1.0);
spinner_image[3] = Image.Text("\\", 0.05, 0.78, 1.0);

spinner_sprite = Sprite();
spinner_sprite.SetImage(spinner_image[0]);
spinner_sprite.SetZ(100);
spinner_sprite.SetX(screen_width / 2 - spinner_image[0].GetWidth() / 2);
spinner_sprite.SetY(screen_height - spinner_image[0].GetHeight() * 4);

label_image = Image.Text("Starting Mighty Linux...", 0.78, 0.84, 1.0);
label_sprite = Sprite();
label_sprite.SetImage(label_image);
label_sprite.SetZ(100);
label_sprite.SetX(screen_width / 2 - label_image.GetWidth() / 2);
label_sprite.SetY(screen_height - label_image.GetHeight() * 2);

frame = 0;
fun refresh_callback()
{
    spinner_sprite.SetImage(spinner_image[Math.Int(frame / 5) % 4]);
    frame++;
}
Plymouth.SetRefreshFunction(refresh_callback);
